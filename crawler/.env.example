# Worker API URL
WORKER_URL=https://hotinsert-api.zhengbijun123.workers.dev

# Crawler auth — this JWT is pre-generated with admin email
# Generate via: node scripts/generate-token.mjs
CRAWLER_TOKEN=your-generated-jwt-token-here

# Pexels API key (free: pexels.com/api, 20k req/month)
PEXELS_API_KEY=your-pexels-api-key

# Run interval (cron expression, default: every 2 hours)
CRON_SCHEDULE=0 */2 * * *

# Max videos per source per run
MAX_PER_SOURCE=5
